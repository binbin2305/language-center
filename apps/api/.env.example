MONGODB_URI=mongodb://localhost:27017/language-center?replicaSet=rs0
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-xxxxxxxx
# Optional, reserved/unused (refresh tokens are opaque values stored as sha256)
# JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
WEB_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
PORT=3000
# đặt production khi deploy (Swagger /api/docs và APP_CLOCK_START chỉ bật với development/e2e/test)
NODE_ENV=development
# Express trust proxy: false (default) | true | hop count (e.g. 1) | address list. Set when behind a reverse proxy.
TRUST_PROXY=false
BCRYPT_COST=12
# Max POST /auth/login requests per IP per minute
LOGIN_RATE_LIMIT=10
# Optional: used by the seed script
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
