{
  "name": "api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "nest start --watch",
    "build": "pnpm --filter @lc/shared build && nest build",
    "start": "node dist/main",
    "test": "jest --passWithNoTests",
    "test:e2e": "jest --config jest-e2e.config.ts --runInBand",
    "seed": "ts-node scripts/seed.ts",
    "dev:mongo": "ts-node scripts/dev-mongo.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "seed:demo": "ts-node scripts/seed-demo.ts",
    "seed:large": "ts-node scripts/seed-large.ts",
    "migrate:class-history": "ts-node scripts/migrate-class-history.ts",
    "migrate:attendance-start-at": "ts-node scripts/migrate-attendance-start-at.ts",
    "test:security": "jest --config jest-security.config.ts --runInBand",
    "test:coverage": "jest --coverage --passWithNoTests",
    "perf": "ts-node test/perf/p95.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "7.3.4",
    "@lc/shared": "workspace:^",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.3",
    "multer": "^2.5.0",
    "pdfmake": "^0.3.13",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.5",
    "@types/pdfmake": "^0.3.3",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.2",
    "pdf-parse": "1.1.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2"
  }
}
