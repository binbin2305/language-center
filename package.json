{
  "name": "language-center",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm --filter @lc/shared build && pnpm -r --filter '!@lc/shared' build",
    "test": "pnpm -r test",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "test:scripts": "bash scripts/__tests__/merge-gate.test.sh",
    "fr-coverage": "bash scripts/fr-coverage.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
